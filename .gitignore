# ==============================================================================
# ProtonVPN Docker - Git Ignore
# ==============================================================================

# Credentials & secrets (never commit your OpenVPN credentials or token keys)
config/login.conf
config/*.conf
.env
.env.local
.env.*.local

# Real OpenVPN profiles (keep example-config/ for templates)
ovpn/*.ovpn
!ovpn/.gitkeep

# Runtime state generated by containers
state/*
!state/.gitkeep

# Dynamic outputs generated by www/ipupdate.sh
www/ip.txt
www/ipinfo.json
www/profile.txt

# Temporary / scratch test files
_tmp*
*.tmp
*.bak

# Python byte code & environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Operating system / IDE specific files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
